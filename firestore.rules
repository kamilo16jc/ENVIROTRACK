rules_version = '2';

// EnviroTrack — Firestore security rules.
// Firestore is the primary database; SharePoint receives a copy from the
// spMirror Cloud Functions (server-side, they bypass these rules).
//
// Access requires an account PROVISIONED by an admin (role claim Inspector /
// Manager / Administrator) — a self-registered Firebase account has no role
// and gets nothing, same as the SharePoint proxy. Everyone also needs
// two-step verification. Every create/update must be
// stamped with the writer's email (_by).
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() { return request.auth != null; }
    // Two-step verification, required for every role: the session typed the
    // authenticator-app code. The server adds the session's sign-in time to the
    // "mfa_s" claim (functions/index.js); accounts on Firebase's own factor also count.
    function secondFactor() {
      return request.auth.token.get('firebase', {}).get('sign_in_second_factor', null) != null
        || request.auth.token.get('auth_time', -1) in request.auth.token.get('mfa_s', []);
    }
    function mfaOk() { return secondFactor(); }
    function provisioned() {
      return signedIn() && request.auth.token.get('role', '') in ['Inspector', 'Manager', 'Administrator'] && mfaOk();
    }
    function isAdmin() { return provisioned() && request.auth.token.get('role', '') == 'Administrator'; }
    function stamped() { return request.resource.data._by == request.auth.token.email; }
    function role() { return request.auth.token.get('role', ''); }

    // Test records: well-formed fields (also keeps markup out of what other users render).
    function validRecord() {
      let d = request.resource.data;
      return d.get('planta', '') in ['1945', '1935', '1931E', '1931W']
        && d.get('resultado', 'Pending') in ['Negative', 'Positive', 'Pending']
        && d.get('fecha', '') is string && d.get('fecha', '').matches('^([0-9]{4}-[0-9]{2}-[0-9]{2})?$')
        && d.get('retestNum', '') is string && d.get('retestNum', '').matches('^((Retest|Vector) #)?[0-9]*$')
        && (d.get('sample', 0) is number || (d.get('sample', '') is string && d.get('sample', '').matches('^[0-9]*$')))
        && (d.get('zone', 0) is number || (d.get('zone', '') is string && d.get('zone', '').matches('^[0-9]?$')))
        && d.get('prodStart', '') is string && d.get('prodStart', '').matches('^([0-2][0-9]:[0-5][0-9])?$')
        && d.get('collTime', '') is string && d.get('collTime', '').matches('^([0-2][0-9]:[0-5][0-9])?$');
    }
    // ── Size limits ──────────────────────────────────────────────
    // Real documents are small (≤ 1 KB, ≤ 31 fields, measured 2026-11-05). These
    // generous caps keep anyone from filling the database or slowing everyone's
    // screens with huge entries. Text is counted in characters, lists in items.
    function fitsN(d, f, n) {
      return !(f in d) || !(d[f] is string || d[f] is list || d[f] is map) || d[f].size() <= n;
    }
    function recordSize() {
      let d = request.resource.data;
      return d.keys().size() <= 60
        && fitsN(d, 'labNotes', 4000) && fitsN(d, 'labResults', 4000) && fitsN(d, 'labResultsImport', 4000)
        && fitsN(d, 'voidReason', 1000) && fitsN(d, 'location', 300) && fitsN(d, 'area', 300)
        && fitsN(d, 'line', 200) && fitsN(d, 'importSource', 300) && fitsN(d, 'failedPathogens', 300)
        && fitsN(d, 'failedPathogensLabel', 300) && fitsN(d, 'enteredByName', 200) && fitsN(d, 'by', 200)
        && fitsN(d, 'voidedBy', 200) && fitsN(d, 'originalId', 100) && fitsN(d, 'id', 100);
    }
    function resolvedSize() {
      let d = request.resource.data;
      return d.keys().size() <= 40
        && fitsN(d, 'notes', 4000) && fitsN(d, 'location', 300) && fitsN(d, 'area', 300)
        && fitsN(d, 'importSource', 300) && fitsN(d, 'enteredByName', 200) && fitsN(d, 'originalId', 100);
    }
    function capaSize() {
      let d = request.resource.data;
      return d.keys().size() <= 50
        && fitsN(d, 'correction', 8000) && fitsN(d, 'preventive', 8000) && fitsN(d, 'corrNote', 4000)
        && fitsN(d, 'actions', 8000) && fitsN(d, 'roots', 8000) && fitsN(d, 'disposition', 4000)
        && fitsN(d, 'rootCause', 4000) && fitsN(d, 'rootNote', 4000) && fitsN(d, 'updatedBy', 200)
        && fitsN(d, 'verifiedBy', 200) && fitsN(d, 'approvedBy', 200);
    }
    function labStatusSize() {
      let d = request.resource.data;
      return d.keys().size() <= 20 && fitsN(d, 'status', 50) && fitsN(d, 'recId', 100);
    }
    function changeSize() {
      let d = request.resource.data;
      return d.keys().size() <= 30 && fitsN(d, 'changes', 30000) && fitsN(d, 'reason', 2000)
        && fitsN(d, 'byName', 200) && fitsN(d, 'samples', 500);
    }

    // Same value before and after the write (a missing field and null count as the default).
    function sameVal(f, dflt) {
      let a = request.resource.data.get(f, dflt);
      let b = resource.data.get(f, dflt);
      return a == b || ((a == null || a == dflt) && (b == null || b == dflt));
    }
    // A result already recorded (Negative / Positive) is changed only by a Manager /
    // Administrator; entering the result of a Pending test is open to every user.
    function resultEditable() {
      return resource == null || resource.data.get('resultado', 'Pending') == 'Pending'
        || role() in ['Manager', 'Administrator']
        || (sameVal('resultado', 'Pending') && sameVal('resultDate', '') && sameVal('labNotes', '')
            && sameVal('failedPathogens', []) && sameVal('failedPathogensLabel', '') && sameVal('labResults', null));
    }
    // Voiding a record (or bringing it back) is an administrator correction.
    function voidUnchanged() {
      return resource == null
        ? request.resource.data.get('voided', false) == false
        : sameVal('voided', false) && sameVal('voidReason', '') && sameVal('voidedBy', '') && sameVal('voidedAt', '');
    }
    // The date of a weekly form is corrected by an Administrator only. Retests keep their
    // own control: anyone working the case may move a scheduled retest.
    function dateEditable() {
      return resource == null || isAdmin() || sameVal('fecha', '')
        || resource.data.get('retestNum', '') != '' || resource.data.get('isRetest', false) == true;
    }
    // Bulk history imports flag documents for a gradual SharePoint copy; clients may not set it.
    function noClientDefer() {
      return request.resource.data.get('_spDefer', false) == false
        || (resource != null && resource.data.get('_spDefer', false) == true);
    }
    // CAPA approval (closing) only by a Manager / Administrator, recorded as themselves.
    function approvalUnchanged() {
      let n = request.resource.data;
      return resource == null
        ? n.get('approvedAt', null) == null && n.get('verifiedBy', null) == null
        : n.get('approvedAt', null) == resource.data.get('approvedAt', null)
          && n.get('approvedBy', null) == resource.data.get('approvedBy', null)
          && n.get('approvedByEmail', null) == resource.data.get('approvedByEmail', null)
          && n.get('verifiedBy', null) == resource.data.get('verifiedBy', null);
    }
    // A CAPA is closed once approved / verified. A closed CAPA — and the positives
    // linked to it — can then be changed by an Administrator only.
    function capaClosed(d) { return d.get('approvedAt', null) != null || d.get('verifiedBy', null) != null; }
    function primaryClosed(link) {
      return link != null && link != '' && exists(/databases/$(database)/documents/capa/$(string(link)))
        && capaClosed(get(/databases/$(database)/documents/capa/$(string(link))).data);
    }
    function capaOpen() {
      return (resource == null || (!capaClosed(resource.data) && !primaryClosed(resource.data.get('linkedTo', ''))))
        && !primaryClosed(request.resource.data.get('linkedTo', ''));
    }
    function canApprove() {
      return role() in ['Manager', 'Administrator']
        && request.resource.data.get('approvedByEmail', '') == request.auth.token.email;
    }

    // ── Core data (was SharePoint-only) ─────────────────────────
    match /records/{id} {
      allow read: if provisioned();
      allow create, update: if provisioned() && stamped() && validRecord() && recordSize() && noClientDefer()
        && resultEditable() && dateEditable() && (isAdmin() || voidUnchanged());
      allow delete: if false;
    }
    match /resolved/{id} {
      allow read: if provisioned();
      allow create, update: if provisioned() && stamped() && resolvedSize() && noClientDefer();
      allow delete: if false;
    }
    // Lab-form log: written by the spProxy function (server) before the flow runs.
    match /submissions/{id} {
      allow read: if provisioned();
      allow write: if false;
    }
    match /masterPoints/{id} {
      allow read: if provisioned();
      allow create, update: if isAdmin() && stamped();
      allow delete: if false;
    }

    // ── Program records ─────────────────────────────────────────
    match /capa/{id} {
      allow read: if provisioned();
      allow create, update: if provisioned() && stamped() && capaSize() && (approvalUnchanged() || canApprove())
        && (isAdmin() || capaOpen());
      allow delete: if isAdmin();
    }
    match /labStatus/{id} {
      allow read: if provisioned();
      allow create, update: if provisioned() && stamped() && labStatusSize();
      allow delete: if isAdmin();
    }
    match /programCapas/{id} {
      allow read: if provisioned();
      allow create, update: if isAdmin() && stamped();
      allow delete: if false;                 // CAPAs are never deleted
    }
    match /mgmtReviews/{id} {
      allow read: if provisioned();
      allow create, update: if isAdmin() && stamped();
      allow delete: if false;
    }
    match /emp/{id} {
      allow read: if provisioned();
      allow create, update: if isAdmin() && stamped();
      allow delete: if false;
    }
    match /training/{id} {
      allow read: if provisioned();
      allow create, update: if isAdmin() && stamped();
      allow delete: if isAdmin();             // removing a record releases its form
    }
    match /trainingForms/{id} {
      allow read: if provisioned();
      allow create, update: if isAdmin() && stamped();
      allow delete: if false;                 // numbers are never reused
    }
    // Test-record audit trail: who changed what, when and why. Append-only.
    match /recordChanges/{id} {
      allow read: if provisioned();
      // Entries with source 'server' are written only by the auditRecords function.
      allow create: if provisioned() && stamped() && changeSize() && request.resource.data.get('byEmail', '') == request.auth.token.email
        && request.resource.data.get('source', '') != 'server';
      allow update, delete: if false;
    }
    match /empChangeLog/{id} {
      allow read: if provisioned();
      allow create: if isAdmin() && stamped();
      allow update, delete: if false;         // audit trail is append-only
    }

    // Consecutive numbers. `records` (test ids) can be advanced by any
    // provisioned user; the rest (TRN-, CAPA-) by administrators only.
    match /counters/{id} {
      allow read: if provisioned();
      allow create, update: if (isAdmin() || (id == 'records' && provisioned()))
        && request.resource.data.n is int
        && (resource == null || (request.resource.data.n > resource.data.n            // only moves forward,
            && (id != 'records' || request.resource.data.n <= resource.data.n + 500)));   // in sane steps
      allow delete: if false;
    }

    // Confidential content (facility map, CAPA template text) — not in the public repo
    match /private/{id} {
      allow read: if provisioned();
      allow write: if isAdmin();
    }

    // spMirror (SharePoint copy bookkeeping) and anything else: server only.
    match /{document=**} { allow read, write: if false; }
  }
}
