# Dependencies
node_modules/

# Local dev / one-time scripts (not part of the deployed app). Any root file
# starting with '_' is a local script and may hold plant data — NEVER commit.
/_*

# Data exports and credentials — NEVER commit
*.xlsx
*.xlsm
*.csv
.runtimeconfig.json
*adminsdk*.json
service-account*.json

# Local tooling
.claude/

# Firebase Functions secrets (flow URLs) — NEVER commit
functions/.env
.env

# Confidential content (facility map, CAPA template text) — served from
# Firestore `private/*` to signed-in users only. NEVER commit.
private-local/
facility-map.html

# Firebase emulator logs
*-debug.log

# Emulator-only env overrides (mock flow URLs)
functions/.env.local
.env.*
